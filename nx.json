{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx,mts,mjs}",
      "!{projectRoot}/**/*.browser.test.{ts,tsx}",
      "!{projectRoot}/vitest.config.{ts,mts}",
      "!{projectRoot}/vitest.browser.config.{ts,mts}",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/Dockerfile"
    ],
    "dbServer": ["{workspaceRoot}/docker-compose.yml", "{workspaceRoot}/tools/dev-ports.mjs"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.prototools",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": { "targetName": "typecheck" }
      }
    },
    {
      "plugin": "@nx/vitest",
      "exclude": ["apps/web/vite.config.ts"],
      "options": { "testTargetName": "test" }
    },
    {
      "plugin": "@nx/oxlint",
      "options": { "targetName": "lint" }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": { "targetName": "eslint" }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": { "targetName": "e2e", "ciTargetName": "e2e-ci" }
    }
  ],
  "sync": {
    "applyChanges": true
  },
  "targetDefaults": {
    "eslint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/.agents/generated.json",
        "{workspaceRoot}/packages/graphql/schema.graphql",
        {
          "externalDependencies": [
            "eslint",
            "@nx/eslint-plugin",
            "@typescript-eslint/parser",
            "@graphql-eslint/eslint-plugin"
          ]
        }
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.oxlintrc.json",
        { "externalDependencies": ["oxlint", "oxlint-tsgolint", "@nx/oxlint"] }
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "e2e": {
      "inputs": ["...", "dbServer"]
    },
    "e2e-ci--**/*": {
      "inputs": ["...", "dbServer"]
    }
  }
}
