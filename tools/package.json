{
  "name": "@acme/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Repo tooling: dev ports, Claude Code hooks, agent-config sync/check, pnpm check.",
  "type": "module",
  "nx": {
    "name": "tools",
    "tags": [
      "scope:tooling",
      "type:tooling"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/.agents/generated.json",
          "{workspaceRoot}/.agents/skills/**/*",
          "{workspaceRoot}/.agents/vendor.json",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/.claude/settings.json",
          "{workspaceRoot}/.claude/agents/**/*",
          "{workspaceRoot}/.claude/workflows/**/*",
          "{workspaceRoot}/AGENTS.md",
          "{workspaceRoot}/apps/web/codegen.ts",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/lefthook.yml",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/packages/graphql/schema.graphql",
          "{workspaceRoot}/packages/db/scripts/*.mjs",
          "{workspaceRoot}/**/package.json",
          "{workspaceRoot}/**/project.json",
          "{workspaceRoot}/**/tsconfig*.json",
          "{workspaceRoot}/**/{vite,vitest,eslint,oxlint,playwright}.config.*",
          "{workspaceRoot}/**/Dockerfile",
          "{workspaceRoot}/.dockerignore",
          "{workspaceRoot}/docker-compose*.yml",
          "{workspaceRoot}/.github/workflows/*.yml",
          "{workspaceRoot}/**/.oxlintrc.json*"
        ]
      }
    }
  }
}
