{
  "name": "@acme/web",
  "version": "0.0.0",
  "private": true,
  "description": "The web app: TanStack Start (SSR) on Nitro, with a same-origin BFF proxy to the private GraphQL API.",
  "type": "module",
  "dependencies": {
    "@acme/ui": "workspace:*",
    "@acme/validators": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "graphql": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/client-preset": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "nitro": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "nx": {
    "name": "web",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "implicitDependencies": [
      "graphql"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "generate-routes",
          "codegen",
          "..."
        ],
        "inputs": [
          "...",
          {
            "dependentTasksOutputFiles": "**/*.ts"
          }
        ]
      },
      "lint": {
        "dependsOn": [
          "generate-routes",
          "codegen",
          "..."
        ],
        "inputs": [
          "...",
          {
            "dependentTasksOutputFiles": "**/*.ts"
          }
        ]
      },
      "test": {
        "dependsOn": [
          "generate-routes",
          "codegen",
          "..."
        ],
        "inputs": [
          "...",
          {
            "dependentTasksOutputFiles": "**/*.ts"
          }
        ]
      },
      "test-browser": {
        "command": "vitest run --config vitest.browser.config.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "codegen"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "HEADED"
          },
          {
            "dependentTasksOutputFiles": "**/*.ts"
          }
        ],
        "outputs": []
      },
      "eslint": {
        "dependsOn": [
          {
            "projects": [
              "api"
            ],
            "target": "print-schema"
          },
          "..."
        ],
        "inputs": [
          "...",
          {
            "dependentTasksOutputFiles": "**/*.graphql"
          }
        ]
      },
      "dev": {
        "command": "node ../../tools/dev-ports.mjs --exec -- sh -c 'PORT=$WEB_PORT exec vite dev'",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true,
        "dependsOn": [
          "codegen",
          "codegen-watch"
        ]
      },
      "generate-routes": {
        "command": "node scripts/generate-routes.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/src/routes/**/*",
          "{projectRoot}/src/{start,router}.{ts,js,mts,mjs,tsx,jsx}",
          "{projectRoot}/tsr.config.json",
          "{projectRoot}/vite.config.ts",
          "{projectRoot}/scripts/generate-routes.mjs",
          {
            "externalDependencies": [
              "@tanstack/react-start",
              "@tanstack/router-generator"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/routeTree.gen.ts"
        ]
      },
      "codegen": {
        "command": "graphql-codegen --config codegen.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "api"
            ],
            "target": "print-schema"
          }
        ],
        "inputs": [
          "{projectRoot}/codegen.ts",
          "{projectRoot}/src/**/*.{ts,tsx}",
          "!{projectRoot}/src/gql/**",
          "!{projectRoot}/src/routeTree.gen.ts",
          "!{projectRoot}/src/**/*.test.{ts,tsx}",
          "{workspaceRoot}/packages/graphql/schema.graphql",
          {
            "dependentTasksOutputFiles": "**/*.graphql"
          },
          {
            "externalDependencies": [
              "@graphql-codegen/cli",
              "@graphql-codegen/client-preset"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/gql/*.ts"
        ]
      },
      "codegen-watch": {
        "command": "NX_DAEMON=${NX_DAEMON:-true} nx watch --projects=api,web --includeDependencies -- nx run web:codegen",
        "continuous": true
      },
      "build": {
        "command": "NODE_ENV=production vite build && node scripts/check-client-bundle.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "generate-routes",
          "codegen"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "dependentTasksOutputFiles": "**/*.ts"
          },
          {
            "externalDependencies": [
              "vite",
              "nitro",
              "@tanstack/react-start"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/.output"
        ]
      },
      "serve": {
        "command": "node ../../tools/dev-ports.mjs --exec -- sh -c 'PORT=$WEB_PORT NITRO_HOST=${NITRO_HOST:-127.0.0.1} exec node .output/server/index.mjs'",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      },
      "serve-e2e": {
        "command": "node ../../tools/dev-ports.mjs --exec -- sh -c 'PORT=$WEB_E2E_PORT API_PORT=$API_E2E_PORT exec node .output/server/index.mjs'",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "NODE_ENV": "production",
            "NITRO_HOST": "127.0.0.1",
            "API_HOST": "127.0.0.1",
            "E2E": "1",
            "INTERNAL_API_SECRET": "e2e-only-fixed-value-not-a-secret-000000"
          }
        },
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
