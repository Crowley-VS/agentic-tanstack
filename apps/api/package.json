{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "description": "The GraphQL API (Yoga + Pothos) on Node. Reads through the Drizzle plugin; writes go through @acme/core.",
  "type": "module",
  "dependencies": {
    "@acme/core": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/validators": "workspace:*",
    "@escape.tech/graphql-armor": "catalog:",
    "@graphql-yoga/plugin-csrf-prevention": "catalog:",
    "@graphql-yoga/plugin-disable-introspection": "catalog:",
    "@pothos/core": "catalog:",
    "@pothos/plugin-complexity": "catalog:",
    "@pothos/plugin-dataloader": "catalog:",
    "@pothos/plugin-drizzle": "catalog:",
    "@pothos/plugin-errors": "catalog:",
    "@pothos/plugin-relay": "catalog:",
    "@pothos/plugin-validation": "catalog:",
    "dataloader": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "tsx": "catalog:"
  },
  "nx": {
    "name": "api",
    "tags": [
      "scope:api",
      "type:app",
      "needs-db"
    ],
    "targets": {
      "dev": {
        "command": "node ../../tools/dev-ports.mjs --exec -- tsx watch src/main.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true,
        "dependsOn": [
          {
            "projects": [
              "db"
            ],
            "target": "db-migrate"
          }
        ]
      },
      "build": {
        "command": "tsdown",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "tsdown"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/migrations"
        ]
      },
      "docker-build": {
        "command": "node tools/stack-guard.mjs && node tools/dev-ports.mjs --exec -- sh -c 'docker compose -p \"$STACK_PROJECT\" -f docker-compose.stack.yml build api migrate'",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/Dockerfile",
          "{workspaceRoot}/.dockerignore",
          "{workspaceRoot}/docker-compose.stack.yml"
        ]
      },
      "serve-e2e": {
        "command": "node ../../tools/dev-ports.mjs --exec -- sh -c 'DATABASE_URL=$E2E_DATABASE_URL PORT=$API_E2E_PORT exec node dist/main.mjs'",
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "NODE_ENV": "production",
            "LISTEN_HOST": "127.0.0.1",
            "READ_ONLY": "false",
            "INTERNAL_API_SECRET": "e2e-only-fixed-value-not-a-secret-000000"
          }
        },
        "continuous": true,
        "dependsOn": [
          "build",
          {
            "projects": [
              "db"
            ],
            "target": "db-seed-e2e"
          }
        ]
      },
      "print-schema": {
        "command": "tsx src/print-schema.ts ../../packages/graphql/schema.graphql",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/packages/graphql/schema.graphql"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "dbServer",
          "{workspaceRoot}/packages/graphql/schema.graphql"
        ]
      }
    }
  }
}
