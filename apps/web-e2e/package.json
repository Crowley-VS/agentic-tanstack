{
  "name": "@acme/web-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests: the production web and API builds on this checkout's e2e ports, against a freshly seeded e2e database.",
  "type": "module",
  "devDependencies": {
    "@nx/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:"
  },
  "nx": {
    "name": "web-e2e",
    "tags": [
      "scope:web",
      "type:e2e"
    ],
    "implicitDependencies": [
      "web",
      "api"
    ],
    "targets": {
      "e2e-base-url": {
        "command": "playwright test",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false
      },
      "e2e-stack": {
        "command": "node tools/e2e-stack.mjs",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "api",
              "web"
            ],
            "target": "docker-build"
          }
        ]
      },
      "stack-up": {
        "command": "node tools/dev-ports.mjs --exec -- sh -c 'docker compose -p \"$STACK_PROJECT\" -f docker-compose.stack.yml up --detach --wait && echo \"stack: web on http://127.0.0.1:$STACK_PORT\"'",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          {
            "projects": [
              "api",
              "web"
            ],
            "target": "docker-build"
          }
        ]
      },
      "stack-down": {
        "command": "node tools/stack-down.mjs",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
