{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PLAYWRIGHT_HTML_OPEN": "never",
    "NX_USE_LOCAL": "true",
    "NODE_DISABLE_COMPILE_CACHE": "1"
  },
  "permissions": {
    "allow": [
