      "Bash(pnpm format)",
      "Bash(pnpm ports *)",
      "Bash(pnpm teardown)",
      "Bash(pnpm prune:orphans)",
      "Bash(pnpm regen *)",
      "Bash(pnpm agents:sync *)",
      "Bash(pnpm agents:check *)",
      "Bash(pnpm agents:nx-check)",
      "Bash(pnpm nx affected -t lint eslint typecheck test test-browser build)",
      "Bash(pnpm nx run tools:lint)",
      "Bash(pnpm nx run tools:eslint)",
      "Bash(pnpm nx run tools:test)",
      "Bash(pnpm nx run validators:lint)",
      "Bash(pnpm nx run validators:eslint)",
      "Bash(pnpm nx run validators:typecheck)",
      "Bash(pnpm nx run validators:test)",
      "Bash(pnpm nx run logger:lint)",
      "Bash(pnpm nx run logger:eslint)",
      "Bash(pnpm nx run logger:typecheck)",
      "Bash(pnpm nx run logger:test)",
      "Bash(pnpm nx run railway-iac:lint)",
      "Bash(pnpm nx run railway-iac:eslint)",
      "Bash(pnpm nx run railway-iac:typecheck)",
      "Bash(pnpm nx run railway-iac:test)",
      "Bash(pnpm nx run ui:lint)",
      "Bash(pnpm nx run ui:eslint)",
      "Bash(pnpm nx run ui:typecheck)",
      "Bash(pnpm nx run ui:test)",
      "Bash(pnpm nx run scripts:lint)",
      "Bash(pnpm nx run scripts:eslint)",
      "Bash(pnpm nx run scripts:typecheck)",
      "Bash(pnpm nx run scripts:test)",
      "Bash(pnpm nx show *)",
      "Bash(node tools/dev-ports.mjs)",
      "Bash(node tools/dev-ports.mjs --print)",
      "Bash(node tools/dev-ports.mjs --json)",
      "Bash(node tools/dev-ports.mjs --env)",
      "Bash(node tools/dev-ports.mjs --get *)",
      "Bash(git status *)",
      "Bash(node tools/pr-review.mjs info *)",
      "Bash(node tools/pr-review.mjs head *)",
      "Bash(node tools/pr-review.mjs diff *)",
      "Bash(node tools/pr-review.mjs threads *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(pnpm nx run core:lint)",
      "Bash(pnpm nx run core:eslint)",
      "Bash(pnpm nx run core:typecheck)",
      "Bash(pnpm nx run core:test)",
      "Bash(pnpm nx run db:lint)",
      "Bash(pnpm nx run db:eslint)",
      "Bash(pnpm nx run db:typecheck)",
      "Bash(pnpm nx run db:test)",
      "Bash(pnpm nx run db:db-up)",
      "Bash(pnpm nx run db:db-down)",
      "Bash(pnpm nx run db:db-migrate)",
      "Bash(pnpm nx run db:db-seed)",
      "Bash(pnpm nx run db:db-check)",
      "Bash(pnpm nx run db:db-generate)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm nx run api:lint)",
      "Bash(pnpm nx run api:eslint)",
      "Bash(pnpm nx run api:typecheck)",
      "Bash(pnpm nx run api:test)",
      "Bash(pnpm nx run api:build)",
      "Bash(pnpm nx run api:print-schema)",
      "Bash(pnpm nx run api:dev)",
      "Bash(pnpm nx run web:lint)",
      "Bash(pnpm nx run web:eslint)",
      "Bash(pnpm nx run web:typecheck)",
      "Bash(pnpm nx run web:test)",
      "Bash(pnpm nx run web:test-browser)",
      "Bash(pnpm nx run web:build)",
      "Bash(pnpm nx run web:generate-routes)",
      "Bash(pnpm nx run web:codegen)",
      "Bash(pnpm nx run web:dev)",
      "Bash(pnpm nx run web:serve)",
      "Bash(pnpm nx run web-e2e:lint)",
      "Bash(pnpm nx run web-e2e:eslint)",
      "Bash(pnpm nx run web-e2e:typecheck)",
      "Bash(pnpm nx e2e web-e2e)",
      "Bash(pnpm nx run api:docker-build)",
      "Bash(pnpm nx run web:docker-build)",
      "Bash(pnpm nx run web-e2e:stack-up)",
      "Bash(pnpm nx run web-e2e:stack-down)",
      "Bash(pnpm nx run web-e2e:e2e-stack)",
      "Bash(pnpm nx run web-e2e:e2e-base-url)",
      "Bash(pnpm exec playwright cli --help *)",
      "Bash(pnpm exec playwright cli open)",
      "Bash(pnpm exec playwright cli open --browser=chromium)",
      "Bash(pnpm exec playwright cli snapshot)",
      "Bash(pnpm exec playwright cli find *)",
      "Bash(pnpm exec playwright cli console *)",
      "Bash(pnpm exec playwright cli requests *)",
      "Bash(pnpm exec playwright cli tab-list)",
      "Bash(pnpm exec playwright cli reload)",
      "Bash(pnpm exec playwright cli list)",
      "Bash(pnpm exec playwright cli close)",
      "Bash(pnpm exec playwright cli close-all)",
      "Bash(pnpm exec intent list *)",
      "Bash(pnpm exec intent load *)",
      "Bash(pnpm dev)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm dlx *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push -qf*)",
      "Bash(git push * -qf*)",
      "Bash(git push -vf*)",
      "Bash(git push * -vf*)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--branches*)",
      "Bash(git push *--prune*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git push * @)",
      "Bash(git push * @ *)",
      "Bash(git push *--delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :**)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(railway)",
      "Bash(railway *)",
      "Bash(*/railway-api.sh)",
      "Bash(*/railway-api.sh *)",
      "Bash(railway-api.sh *)",
      "Bash(bash railway-api.sh *)",
      "Bash(sh railway-api.sh *)",
      "mcp__plugin_railway_*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(npx *)",
      "Bash(pnpm agents:nx *)",
      "Bash(pnpm nx configure-ai-agents *)",
      "Bash(pnpm exec nx configure-ai-agents *)",
      "Bash(nx configure-ai-agents *)",
      "Bash(playwright-cli *)",
      "Bash(pnpm dlx @playwright/cli*)",
      "Bash(pnpm exec playwright cli install *)",
      "Bash(pnpm playwright cli install *)",
      "Bash(pnpm exec playwright init-skills *)",
      "Bash(pnpm playwright init-skills *)",
      "Bash(pnpm exec intent install *)",
      "Bash(pnpm intent install *)",
      "Bash(pnpm exec intent hooks *)",
      "Bash(pnpm intent hooks *)",
      "Bash(pnpm dlx @tanstack/intent*)",
      "Bash(drizzle-kit skills *)",
      "Bash(*/drizzle-kit skills)",
      "Bash(*/drizzle-kit skills *)",
      "Bash(pnpm drizzle-kit skills *)",
      "Bash(pnpm * drizzle-kit skills)",
      "Bash(pnpm * drizzle-kit skills *)",
      "Bash(pnpm dlx drizzle-kit@* skills)",
      "Bash(pnpm dlx drizzle-kit@* skills *)",
      "Edit(/.claude/skills/**)",
      "Edit(/apps/web/src/gql/**)",
      "Edit(/apps/web/src/routeTree.gen.ts)",
      "Edit(/packages/graphql/schema.graphql)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agent-hooks/guard-paths.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agent-hooks/format.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agent-hooks/pr-opened.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    },
    "railway-skills": {
      "source": {
        "source": "github",
        "repo": "railwayapp/railway-skills"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "railway@railway-skills": true,
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  }
}
