# Copy to .env and set the values below (the template's bootstrap did this for the first checkout).
# Never commit .env.
# Ports and DATABASE_URL are NOT set here: tools/dev-ports.mjs derives them per checkout/worktree
# (see `pnpm ports`). To override one, set it in your shell environment (e.g. `WEB_PORT=8080 pnpm ports`),
# never in this file: dev-ports does not read .env, and .env is copied into every new worktree
# (.worktreeinclude), so a port set here would make all worktrees collide.

# Shared secret between the web BFF and the API: a long random value, e.g. the output of
#   node -p "require('node:crypto').randomBytes(32).toString('hex')"
INTERNAL_API_SECRET=replace-with-a-long-random-value
