# Copy to .env and set the values below (the template's bootstrap did this for the first checkout).
# Never commit .env.
# Ports and DATABASE_URL are NOT set here: tools/dev-ports.mjs derives them per checkout/worktree
# (see `pnpm ports`). To override one, set it in your shell environment (e.g. `WEB_PORT=8080 pnpm ports`),
# never in this file: dev-ports does not read .env, and .env is copied into every new worktree
# (.worktreeinclude), so a port set here would make all worktrees collide.

# Shared secret between the web BFF and the API: a long random value, e.g. the output of
#   node -p "require('node:crypto').randomBytes(32).toString('hex')"
INTERNAL_API_SECRET=replace-with-a-long-random-value

# API kill switch: `true` rejects every mutation (queries keep working). Default false.
# READ_ONLY=true

# API listen address. Default: `::` (every interface) in production, 127.0.0.1 in development.
# 127.0.0.1 keeps a production-mode API on this machine only.
# LISTEN_HOST=127.0.0.1

# The request header in which the proxy in front of the web server names the browser's IP (the
# BFF counts writes per IP and passes it to the API's log). Default x-real-ip. Empty: no proxy in
# front, use the socket address (otherwise any client can claim any address in that header).
# REAL_IP_HEADER=x-real-ip

# Web BFF write rate limit: mutations per client IP (IPv6: per /64), as <writes>/<window> in s, m
# or h. Default 10/60s, on in `pnpm dev` too: set `off` for scripts that write a lot (they get 429
# otherwise).
# WRITE_RATE_LIMIT=10/60s

# Test-only: the e2e servers set E2E=1, which turns the write rate limit off. Never set it in
# production. Default false.
# E2E=1
